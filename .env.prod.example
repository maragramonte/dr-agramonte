# Variables del despliegue en VPS (docker-compose.prod.yml).
# Copiar a .env.prod EN EL SERVIDOR y rellenar. Nunca se sube al repo.
#
#   cp .env.prod.example .env.prod && nano .env.prod
#
# Guía completa: docs/DESPLIEGUE-VPS.md

# --- Dominio y certificado -------------------------------------------------
# Sin https:// y sin barra final. El apex redirige al www con un 301.
DOMAIN_WWW=www.example.com
DOMAIN_APEX=example.com
# Correo al que Let's Encrypt avisa si el certificado tiene problemas.
ACME_EMAIL=contacto@example.com

# --- Base de datos ---------------------------------------------------------
POSTGRES_DB=dr_agramonte
POSTGRES_USER=agramonte
# OBLIGATORIA. Generar una larga y aleatoria:  openssl rand -base64 32
POSTGRES_PASSWORD=

# --- Seguridad de la aplicación -------------------------------------------
# OBLIGATORIA, mínimo 32 caracteres. Generar:  openssl rand -base64 48
# Si cambia, todas las sesiones abiertas dejan de valer (los JWT se invalidan).
JWT_SECRET=

# --- Cuenta del médico ------------------------------------------------------
# OBLIGATORIAS. La base de datos se crea con una cuenta de demostración
# (dr.agramonte@example.com / Medico123!) cuya contraseña está escrita en las
# migraciones, así que es pública. Al arrancar, la aplicación reescribe esa
# cuenta con estos valores; sin ellos, docker compose no levanta.
MEDICO_EMAIL=doctor@example.com
# Mínimo 8 caracteres y distinta de la de demostración. Generar:  openssl rand -base64 18
MEDICO_PASSWORD=

# --- Correo del formulario de contacto (opcional) --------------------------
# Sin SMTP el formulario sigue funcionando, pero solo deja traza en los logs.
# MAIL_HOST=smtp.example.com
# MAIL_PORT=587
# MAIL_USERNAME=contacto@example.com
# MAIL_PASSWORD=
# MAIL_FROM=contacto@example.com
# CONTACT_INBOX=contacto@example.com
# Base pública de la web: con ella se construyen los enlaces que viajan por correo.
# El de activación de una cuenta invitada, que sin SMTP configurado responde 503 y
# nunca activa la cuenta a ciegas, y el de acceso a una cita reservada sin cuenta.
# En producción conviene tener MAIL_* configurado: sin él, quien reserve sin cuenta
# solo podrá llegar a su cita desde el navegador donde la hizo.
# APP_URL_PUBLICA=https://www.example.com
# También es la URL que llevan canonical, sitemap.xml y robots.txt dentro de la
# imagen. Si no la pones, se usa https://DOMAIN_WWW.

# --- Avisos por WhatsApp/SMS (opcional) ------------------------------------
# TWILIO_ENABLED=true
# TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# TWILIO_AUTH_TOKEN=
# TWILIO_CHANNEL=whatsapp
# TWILIO_FROM=whatsapp:+14155238886
# TWILIO_NOTIFY_TO=whatsapp:+346XXXXXXXX
# Solo apaga los SMS/WhatsApp al paciente; Telegram no se ve afectado
# TWILIO_NOTIFY_PATIENTS=true
# Recordatorio de la víspera: sale por correo (con el enlace para cancelar si la cita
# se reservó sin cuenta), por Telegram y por SMS/WhatsApp. Cada canal comprueba su
# propia configuración, así que apagar Twilio ya no apaga el recordatorio entero.
# RECORDATORIO_HORAS=24
# RECORDATORIO_CRON=0 */15 * * * *
# Respaldo de la clave antigua, que sigue valiendo:
# TWILIO_REMINDER_HOURS=24

# --- Avisos por Telegram (opcional) ----------------------------------------
# TELEGRAM_ENABLED=true
# TELEGRAM_BOT_TOKEN=123456789:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# TELEGRAM_BOT_USERNAME=DrAgramonteBot
# TELEGRAM_WEBHOOK_SECRET=

# --- Agenda y límite de peticiones (opcional) ------------------------------
# Los huecos reservables se mantienen siempre abiertos a esta distancia, con una
# tarea que amplía la ventana cada madrugada. Antes solo los sembraban las
# migraciones y la agenda se agotaba a los ~90 días del despliegue.
# AGENDA_DIAS_FUTURO=90
# AGENDA_CRON=0 30 3 * * *
# Peticiones por IP en login, contacto y reserva sin cuenta (por ventana).
# RATE_LIMIT_MAX=10
# RATE_LIMIT_VENTANA_SEGUNDOS=300
# RATE_LIMIT_ENABLED=true

# --- Copias de seguridad (scripts/backup-db.sh) ----------------------------
# Clave pública de age: en el servidor solo queda la copia cifrada. La privada se
# queda en tu ordenador. Ver docs/DESPLIEGUE-VPS.md, apartado 8.
# BACKUP_AGE_RECIPIENT=age1...
# Remoto de rclone fuera del servidor. Exige BACKUP_AGE_RECIPIENT.
# BACKUP_RCLONE_DESTINO=copias:dr-agramonte
# RETENER=14
# RETENER_REMOTO_DIAS=30
