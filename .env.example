# Copiar a .env en la raíz del proyecto para docker compose
JWT_SECRET=cambiar-por-un-secreto-largo-y-aleatorio-min-32-chars

# Usuario médico de prueba (Flyway V3): dr.agramonte@example.com / Medico123!
DB_USER=postgres
DB_PASSWORD=postgres

# Opcional: correo para formulario de contacto
# MAIL_HOST=smtp.example.com
# MAIL_PORT=587
# MAIL_USERNAME=
# MAIL_PASSWORD=
# MAIL_FROM=contacto@dragramonte.com
# CONTACT_INBOX=contacto@dragramonte.com

# Twilio: aviso al móvil cuando se reserva o cancela una cita (WhatsApp o SMS)
# TWILIO_ENABLED=true
# TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# TWILIO_AUTH_TOKEN=tu_auth_token
# Canal: whatsapp (sandbox o número aprobado) o sms
# TWILIO_CHANNEL=whatsapp
# Remitente Twilio (sandbox WhatsApp suele ser whatsapp:+14155238886)
# TWILIO_FROM=whatsapp:+14155238886
# Tu móvil en formato E.164 (ej. España)
# TWILIO_NOTIFY_TO=whatsapp:+346XXXXXXXX
# Avisos al paciente (confirmación, cancelación, recordatorio ~24 h antes)
# TWILIO_NOTIFY_PATIENTS=true
# TWILIO_REMINDER_HOURS=24

# Telegram: mismos avisos al paciente por un bot (alternativa/complemento a Twilio)
# TELEGRAM_ENABLED=true
# Token del bot que da @BotFather
# TELEGRAM_BOT_TOKEN=123456789:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Usuario del bot sin @ (para el enlace https://t.me/<bot>?start=<token>)
# TELEGRAM_BOT_USERNAME=DrAgramonteBot
# Secreto que valida el webhook; el mismo que se pasa en setWebhook (1-256 chars A-Za-z0-9_-)
# TELEGRAM_WEBHOOK_SECRET=cambiar-por-un-secreto-largo-y-aleatorio
